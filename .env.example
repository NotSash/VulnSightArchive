# VulnSight environment configuration
#
# Copy to `.env.local` and fill in only what you need. Every value here is
# OPTIONAL: when a dependency is absent, the scanner records a coverage note in
# the report explaining what could not be checked, rather than inventing data.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error   (default: debug in dev, info in production)
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Nmap — port and service/version enumeration
# ---------------------------------------------------------------------------
# Only needed if `nmap` is not on PATH.
# NMAP_PATH=/usr/bin/nmap

# ---------------------------------------------------------------------------
# Nuclei — template-based vulnerability scanning
# ---------------------------------------------------------------------------
# Only needed if `nuclei` is not on PATH.
# NUCLEI_PATH=/usr/local/bin/nuclei
#
# Template directory. If unset, common locations such as
# ~/nuclei-templates are probed automatically.
# NUCLEI_TEMPLATES=/home/user/nuclei-templates
#
# Maximum time Nuclei may run, in milliseconds (30000-1800000). Default 420000
# (7 minutes). Results collected before the deadline are always kept, and the
# report flags the run as partial rather than discarding them.
# NUCLEI_TIMEOUT_MS=420000

# ---------------------------------------------------------------------------
# OWASP ZAP — passive analysis only (no spider, no active scan)
# ---------------------------------------------------------------------------
# Start ZAP in daemon mode:
#   zap.sh -daemon -host 127.0.0.1 -port 8080
# ZAP_API_URL=http://127.0.0.1:8080
# ZAP_API_KEY=

# ---------------------------------------------------------------------------
# NVD — CVE enrichment
# ---------------------------------------------------------------------------
# Works without a key, but an API key raises the rate limit substantially
# (5 -> 50 requests per 30s). Free: https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=

# ---------------------------------------------------------------------------
# Optional AI summary rewriting
# ---------------------------------------------------------------------------
# AI NEVER detects vulnerabilities and NEVER changes severity or risk scores.
# It only rewrites already-verified findings into clearer prose. Without a key,
# the deterministic rule engine is used and a coverage note is recorded.
#
# Gemini takes precedence when both are set.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Abuse controls
# ---------------------------------------------------------------------------
# VulnSight points real security tooling at whatever host a visitor types, so
# the public endpoint is rate limited and capped. Defaults are tuned for a
# 2-core / 12 GB host; raise them only if the machine can genuinely take it.
#
# Scans one client (by IP) may start within the window. Default 5.
# RATE_LIMIT_PER_CLIENT=5
#
# Length of the rolling rate-limit window, in milliseconds. Default 3600000 (1h).
# RATE_LIMIT_WINDOW_MS=3600000
#
# Hard ceiling on simultaneous scans across the process. Each comprehensive
# scan occupies a core for minutes, so this is the control that keeps the box
# responsive. Default 3.
# MAX_CONCURRENT_SCANS=3
#
# Optional shared secret that gates every scan. Leave UNSET for a fully public
# instance (the intended end state); set it to keep a deployment private during
# a soft launch without building user accounts.
# ACCESS_CODE=

# ---------------------------------------------------------------------------
# Test configuration
# ---------------------------------------------------------------------------
# Set to 1 to skip API integration tests (they start a dev server and scan
# example.com, so they need network access).
# SKIP_API_TESTS=0

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# Turns this deployment into a preview: the scan form is replaced by a short
# explanation, the docked header bar becomes a link to the sample report, and
# POST /api/scan returns 503 with a reason.
#
# Set this on any host that cannot run the scanners (Vercel, Netlify, and any
# other serverless platform). Without it such a host still answers scan
# requests, using only the checks that need nothing but `fetch`, and returns a
# thin report with nothing corroborated. That looks like the finished product
# to a visitor, which is the one outcome this project must not produce.
#
# NEXT_PUBLIC_ because the browser needs it too: the form has to be visibly
# replaced before anyone clicks, not merely rejected afterwards. These are
# compiled into the bundle at build time, so it must be set BEFORE building.
#
# NEXT_PUBLIC_DEMO_MODE=1
