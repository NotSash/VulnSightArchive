{
  "name": "vulnsight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude tests/api.test.ts",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run build && pnpm run test:e2e",
    "audit": "pnpm audit --audit-level low",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.10.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.19.1",
    "playwright": "^1.62.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "styled-components": "^6.4.4",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^3.2.7",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "description": "Evidence-based web security assessment platform with multi-tool correlation.",
  "license": "MIT"
}
